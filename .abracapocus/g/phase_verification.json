        "command": [
          "cmake",
          "-S",
          ".",
          "-B",
          "build",
          "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
        ]
      },
      {
        "name": "cmake_build",
        "command": [
          "cmake",
          "--build",
